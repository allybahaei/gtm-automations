{
  "name": "solus-slides",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "playwright install chromium",
    "generate": "tsx --env-file=.env src/generate.ts",
    "render": "tsx src/render.ts",
    "build": "npm run generate && npm run render",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
